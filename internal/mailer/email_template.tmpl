{{define "subject"}}{{.Subject}}{{end}}

{{define "plainBody"}}
Dear {{.Recipient}},

{{.Body}}

Best regards,
The AI4ALL Team
{{end}}

{{define "htmlBody"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{{.Subject}}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6f5;">
<div role="article" aria-roledescription="email" lang="en" style="background-color: #f4f6f5; padding: 32px 0;">
    <table role="presentation" style="width: 100%; border: none; border-spacing: 0;">
        <tr>
            <td align="center" style="padding: 0;">
                <table role="presentation" style="width: 94%; max-width: 600px; border: none; border-spacing: 0; text-align: left;
                       font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: #0f2a21;
                       background-color: #ffffff; border-radius: 12px; overflow: hidden;">
                    <tr>
                        <td style="padding: 28px 32px; background-color: #0e2b22;">
                            <span style="font-size: 22px; font-weight: bold; letter-spacing: 0.5px; color: #ffffff;">AI4ALL</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 32px;">
                            <p style="margin: 0 0 20px;">Dear {{.Recipient}},</p>
                            <p style="margin: 0 0 20px; white-space: pre-line;">{{.Body}}</p>
                            <p style="margin: 0 0 28px;">Best regards,<br/>The AI4ALL Team</p>
                            <a href="{{.URL}}/api/v1/redirect?id={{.EmailId}}" style="background: #1f6b52; text-decoration: none;
                               padding: 11px 24px; color: #ffffff; border-radius: 6px; display: inline-block; font-weight: bold;">
                                Learn more
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 20px 32px; text-align: center; font-size: 12px; color: #6a7c74; background-color: #f8faf9;">
                            &copy; AI4ALL
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    <img src="{{.URL}}/api/v1/redirect?id={{.EmailId}}" width="1" height="1" alt="" style="display: block; border: 0;"/>
</div>
</body>
</html>
{{end}}
