# SMTP settings used by the API.
SMTPPORT=587
SMTPSENDER=
SMTPHOST=
SMTPUSERNAME=
SMTPPASS=

# Public URL used in email links.
URL=http://localhost:4000

# Admin access for the first implementation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Certificate rendering defaults for assests/template.jpg.
CERTIFICATE_TEMPLATE=./assests/template.jpg
CERTIFICATE_NAME_X=0
CERTIFICATE_NAME_Y=60
CERTIFICATE_NAME_SIZE=24
# mm from the bottom-left corner
CERTIFICATE_NUMBER_X=15
CERTIFICATE_NUMBER_Y=15
CERTIFICATE_NUMBER_SIZE=10

# Redis: shared rate limits, sessions, settings fan-out and the outbox stream.
REDIS_URL=redis://localhost:6379/0

# Delivery tuning. SMTP_RATE_PER_SECOND and SMTP_DAILY_LIMIT are global across
# every replica: set them to your provider's limits (Gmail: 500/day,
# Google Workspace: 2000/day). 0 means unlimited.
WORKER_CONCURRENCY=4
SMTP_RATE_PER_SECOND=2
SMTP_DAILY_LIMIT=0
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_MAX_INFLIGHT=100

# HTTP. Set COOKIE_SECURE=true behind HTTPS. TRUSTED_PROXIES lists the
# load balancer CIDRs allowed to set X-Forwarded-For.
COOKIE_SECURE=false
TRUSTED_PROXIES=
API_RATE_LIMIT_RPS=10
API_RATE_LIMIT_BURST=20
CORS_TRUSTED_ORIGINS=http://localhost:3000 http://localhost:5173

# Where clicks on the link in tracked one-off emails go (e.g. the AI4ALL site).
# Leave empty to only record the open.
TRACKING_REDIRECT_URL=
